{
  "name": "emoji-suggestions-bar",
  "version": "1.0.0",
  "description": "Liquid-glass emoji suggestion bar for Linux (GNOME/Wayland)",
  "homepage": "https://github.com/Not-Sami-01/emojis-suggestions",
  "desktopName": "emoji-suggestions-bar",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:show": "electron . --show",
    "build:data": "node scripts/download-emoji-data.js && node scripts/build-emoji-db.js",
    "build": "npm run build:data && electron-builder --linux",
    "build:linux": "electron-builder --linux AppImage deb",
    "setup": "bash scripts/setup.sh",
    "test": "node --test"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.emoji-suggestions-bar",
    "productName": "Emoji Suggestions",
    "icon": "build/icon.svg",
    "asar": true,
    "electronLanguages": ["en-US"],
    "files": [
      "main.js",
      "preload.js",
      "setup-preload.js",
      "settings-preload.js",
      "index.html",
      "installer.html",
      "settings.html",
      "src/**/*",
      "assets/logo-mark.svg",
      "data/emojis.json",
      "package.json"
    ],
    "linux": {
      "category": "Utility;TextTools;",
      "executableName": "emoji-suggestions-bar",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Emoji Suggestions Bar contributors",
      "synopsis": "Keyboard-driven emoji picker",
      "description": "A searchable emoji picker and suggestion bar for Linux desktops.",
      "artifactName": "emoji-suggestions-bar-${version}.${ext}",
      "syncDesktopName": true
    }
  }
}
